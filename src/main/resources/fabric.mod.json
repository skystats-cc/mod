{
  "schemaVersion": 1,
  "id": "skystats",
  "version": "${version}",
  "name": "SkyStats",
  "description": "Hypixel SkyBlock money tracking for skystats.cc. Link your account and track your co-op.",
  "authors": ["SkyStats team"],
  "contact": {
    "homepage": "https://skystats.cc",
    "sources": "https://github.com/skystats-cc/mod"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [{ "adapter": "kotlin", "value": "cc.skystats.mod.SkyStats" }]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.0"
  }
}
